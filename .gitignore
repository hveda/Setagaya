# Binaries and build output. One entry per cmd/: `go build ./cmd/<name>/...`
# drops the binary in the working directory, so all four can land at the repo
# root (a stray 39MB /scheduler from exactly that is what prompted listing
# the other three alongside honryu-api).
*.exe
/bin/
/dist/
/honryu-api
/scheduler
/calibrator
/sidecar

# web/ (React SPA) build output and dependencies. dist/.gitkeep is tracked
# on purpose -- cmd/api's go:embed directive needs at least one file under
# web/dist to compile even in a checkout that has never run `bun run build`;
# a real build's emptyOutDir removes it locally, which is expected.
web/node_modules/
web/dist/*
!web/dist/.gitkeep
web/*.tsbuildinfo
# layout-check --screenshots output (diagnostic PNGs, regenerated on demand)
web/.layout-check/

# Test & coverage artifacts
cover.out
*.coverprofile
coverage.out
coverage.html

# Local object-store data
storage-data/

# Cortex workflow artifacts
/.cortex/

# Local agent/dev-tool state, per developer rather than per repo. opencode.json
# hardcodes absolute paths to this machine's toolchain (e.g. its gopls binary),
# so it is not shareable even in principle; the .bak-* files are its own
# rewrites. repomix output is a local codebase dump, not a build artifact.
repomix-output.md
repomix.config.json
opencode.json
opencode.json.bak-*
.pi/

# Editor / OS
.DS_Store
*.tmp
*.temp
debug.yaml
.cortex/
