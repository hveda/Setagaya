# Binaries and build output
*.exe
/bin/
/dist/
honryu-api

# web/ (React SPA) build output and dependencies. dist/.gitkeep is tracked
# on purpose -- cmd/api's go:embed directive needs at least one file under
# web/dist to compile even in a checkout that has never run `bun run build`;
# a real build's emptyOutDir removes it locally, which is expected.
web/node_modules/
web/dist/*
!web/dist/.gitkeep
web/*.tsbuildinfo

# Test & coverage artifacts
cover.out
*.coverprofile
coverage.out
coverage.html

# Local object-store data
storage-data/

# Cortex workflow artifacts
/.cortex/

# repomix output (local codebase-dump tool, not a build artifact)
repomix-output.md
repomix.config.json

# Editor / OS
.DS_Store
*.tmp
*.temp
debug.yaml
